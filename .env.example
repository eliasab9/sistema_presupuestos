# ─────────────────────────────────────────────────────────────────────────────
# Sistema de Presupuestos — Variables de Entorno
# Copiá este archivo a  .env.local  y completá los valores reales.
# NUNCA subas .env.local a git (ya está en .gitignore).
# ─────────────────────────────────────────────────────────────────────────────


# ── ACCESO A LA APP ───────────────────────────────────────────────────────────
# Clave que el usuario escribe en la pantalla de login
SITE_PASSWORD=

# Secreto para firmar la cookie de sesión (cadena larga y aleatoria)
# Generá uno con: openssl rand -base64 32
SESSION_SECRET=

# URL pública de la app (sin trailing slash)
NEXT_PUBLIC_APP_URL=http://localhost:3000


# ── GOOGLE OAUTH — Drive y Sheets ────────────────────────────────────────────
#
# El sistema usa OAuth 2.0 con refresh token (NO Service Account).
# Cómo obtener las credenciales:
#   1. Ir a https://console.cloud.google.com
#   2. Crear proyecto → Habilitar Google Drive API y Google Sheets API
#   3. Credenciales → OAuth 2.0 → Tipo "Aplicación web"
#   4. URI de redirección: ${NEXT_PUBLIC_APP_URL}/api/google-drive/callback
#   5. Copiar Client ID y Client Secret
#   6. Ir a /setup-drive en la app para completar el flujo OAuth
#      y obtener el Refresh Token (se muestra al finalizar)
#

GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_OAUTH_REFRESH_TOKEN=


# ── GOOGLE SHEETS ─────────────────────────────────────────────────────────────
# ID de la planilla (se extrae de la URL: /spreadsheets/d/<SPREADSHEET_ID>/edit)
SPREADSHEET_ID=

# GID (ID numérico) de cada pestaña, visible en la URL como ?gid=<numero>
SHEET_GID_BEMEC=
SHEET_GID_BAMORE=


# ── EMAIL — Gmail SMTP por empresa ───────────────────────────────────────────
#
# Cómo obtener la Contraseña de Aplicación:
#   1. Cuenta Gmail → Seguridad → Verificación en dos pasos (activar)
#   2. Seguridad → Contraseñas de aplicación
#   3. Aplicación: Correo | Dispositivo: Otro → "Presupuestos"
#   4. Copiar la contraseña de 16 caracteres (sin espacios)
#

GMAIL_USER_BEMEC=cotizacionesbemec@gmail.com
GMAIL_PASS_BEMEC=
GMAIL_REPLY_BEMEC=ventas@bemec.ar

GMAIL_USER_BAMORE=cotizacionesbamore@gmail.com
GMAIL_PASS_BAMORE=
GMAIL_REPLY_BAMORE=ventas@bamore.com.ar


# ── BASE DE DATOS — Neon Postgres ────────────────────────────────────────────
# Conexión pooled (para la mayoría de los casos, serverless/edge)
DATABASE_URL=

# Conexión directa sin pgbouncer (para migraciones con drizzle-kit)
DATABASE_URL_UNPOOLED=


# ── ANTHROPIC — Extracción de facturas por IA ────────────────────────────────
# Necesaria para el módulo de facturas
# Obtener en: https://console.anthropic.com/account/keys
ANTHROPIC_API_KEY=
